    {
      "id": 10,
      "type": "bargauge",
      "title": "Median candidates surviving each stage",
      "description": "A funnel is magnitude across ordered stages, so bars beat lines. ONE QUERY PER STAGE, in pipeline order, which is the whole reason for four targets: a single `by (stage)` query returns series sorted ALPHABETICALLY, so the bars read retrieved/scored/served/unblocked, and a funnel whose bars are out of order is not conveying a funnel. unblocked below 1 for 10m is RecsysSeenFilterSaturated: the seen-list is blocking everything. incomplete_rows is not a funnel stage and lives on the degradation panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(recsys_stage_candidates_bucket{stage=\"retrieved\"}[10m])))",
          "legendFormat": "retrieved",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(recsys_stage_candidates_bucket{stage=\"unblocked\"}[10m])))",
          "legendFormat": "unblocked",
          "refId": "B",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(recsys_stage_candidates_bucket{stage=\"scored\"}[10m])))",
