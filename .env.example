MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Shell-sourced convenience, not a credential. The Makefile -includes this file
# but exports only the two MINIO_ vars, so make expanding $(...) to nothing here
# costs nothing -- escaping it as $$(...) would only break `source .env`.
JAVA_HOME=$(/usr/libexec/java_home -v 21)
